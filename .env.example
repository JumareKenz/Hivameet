# Postgres (docker-compose by default)
DATABASE_URL="postgresql://hivameet:hivameet@localhost:5433/hivameet"

# Auth.js
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_URL="http://localhost:3000"

# LLM (meeting intelligence extraction, chat-with-meeting)
# Prefers Anthropic when set; falls back to Groq otherwise (src/lib/ai/model.ts).
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""

# Meeting bot orchestration — self-hosted Attendee instance
# (github.com/attendee-labs/attendee). See README for how to run it.
# ATTENDEE_API_KEY comes from its own UI after you create an account there.
# Transcription: this project's "OpenAI" credential in Attendee's UI is set
# to the same Groq key (Groq's API is OpenAI-compatible) — see README. Zoom
# additionally needs its own OAuth app credentials configured in Attendee's
# own settings (not here) to join Zoom calls at all.
ATTENDEE_BASE_URL="http://localhost:8000"
ATTENDEE_API_KEY=""
ATTENDEE_WEBHOOK_SECRET=""

# Public app URL, used for bot webhook callbacks
APP_BASE_URL="http://localhost:3000"

# Payments — Paystack (NGN self-serve credit top-ups)
# Get this from the Paystack dashboard (Settings > API Keys & Webhooks).
# Register {APP_BASE_URL}/api/billing/webhooks/paystack as a webhook there too.
PAYSTACK_SECRET_KEY=""
